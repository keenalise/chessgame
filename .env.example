# ---------------------------------------------------------------------------
# KeenChess environment variables (EXAMPLE / TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored and holds your real config. This `.env.example`
# file is committed on purpose so collaborators know which variables to set.
#
# These are Firebase *Web app* config values. Get them from:
#   Firebase Console -> Project settings (gear icon) -> General tab
#   -> "Your apps" -> select / create a Web app -> "SDK setup and configuration"
#   -> choose "Config". Copy each field into the matching variable below.
#
# NOTE ON SECURITY: The NEXT_PUBLIC_ prefix means Next.js inlines these values
# into the browser bundle. That is correct and expected for Firebase web apps —
# the Firebase "apiKey" is a public project identifier, NOT a secret. Real
# protection comes from Firebase Security Rules and the Authorized Domains list
# (Authentication -> Settings -> Authorized domains). Do not put any truly
# secret value (admin keys, service-account JSON, etc.) in a NEXT_PUBLIC_ var.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
